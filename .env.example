# Ohne SAP_SL_URL startet die App im Demo-Modus mit Testdaten.
# Service-Layer-Adresse (meist Port 50000, https):
SAP_SL_URL=https://sap-b1-server:50000/b1s/v1/
# Fester Mandant (Firmendatenbank). Leer lassen = Mandant wird beim Login abgefragt.
SAP_COMPANY_DB=SBODEMODE
# CA-Zertifikat des Service Layers, falls selbst signiert (PEM-Datei):
# SAP_SL_CA=/pfad/zu/sap-ca.pem

PORT=3000
# HTTPS direkt in der App (für die Handykamera nötig), alternativ Reverse-Proxy:
# TLS_CERT=/pfad/zu/cert.pem
# TLS_KEY=/pfad/zu/key.pem
# BEHIND_HTTPS_PROXY=1
